---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
---

<Base title="개인정보처리방침 | OMYQT">
  <main class="px-4 py-12 sm:py-16">
    <article class="mx-auto min-w-0 max-w-3xl rounded-2xl border border-border bg-background p-6 sm:p-10">
      <a href="/" class="text-sm text-muted-foreground transition-colors hover:text-foreground">← OMYQT 홈</a>
      <h1 class="mt-6 font-display text-3xl font-bold text-foreground">개인정보처리방침</h1>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        {site.company.legalName}는 OMYQT 서비스의 운영 주체입니다.
      </p>

      <section class="mt-10">
        <h2 class="text-lg font-semibold text-foreground">개인정보보호담당자</h2>
        <p class="mt-3 min-w-0 break-words leading-relaxed text-muted-foreground [overflow-wrap:anywhere]">
          이메일:
          <a
            href={`mailto:${site.company.privacyOfficerEmail}`}
            class="underline underline-offset-2 transition-colors hover:text-foreground"
          >
            {site.company.privacyOfficerEmail}
          </a>
        </p>
      </section>

      <section aria-label="회사 정보" class="mt-10 border-t border-border pt-6">
        <h2 class="text-lg font-semibold text-foreground">회사 정보</h2>
        <dl class="mt-3 min-w-0 space-y-2 text-sm leading-relaxed text-muted-foreground">
          <div><dt class="inline font-medium text-foreground">상호 </dt><dd class="inline">{site.company.legalName}</dd></div>
          <div><dt class="inline font-medium text-foreground">사업자등록번호 </dt><dd class="inline">{site.company.businessRegistrationNumber}</dd></div>
          <div class="break-words [overflow-wrap:anywhere]"><dt class="inline font-medium text-foreground">사업장 주소 </dt><dd class="inline">{site.company.businessAddress}</dd></div>
        </dl>
      </section>
    </article>
  </main>
  <Footer />
</Base>
